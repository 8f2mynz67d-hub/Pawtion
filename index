<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Pawtion - คำนวณปริมาณอาหารสัตว์เลี้ยง</title>
  
  <!-- รองรับการเพิ่มลงหน้าจอโฮมมือถือ (PWA / Web App) -->
  <meta name="theme-color" content="#a855f7">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="Pawtion">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%239333ea'/%3E%3Ccircle cx='32' cy='38' r='9' fill='%23fde047'/%3E%3Ccircle cx='50' cy='28' r='9' fill='%23fde047'/%3E%3Ccircle cx='68' cy='38' r='9' fill='%23fde047'/%3E%3Cpath d='M50 48c-14 0-24 10-24 20 0 7 6 12 13 12 4 0 8-2 11-2s7 2 11 2c7 0 13-5 13-12 0-10-10-20-24-20z' fill='%23fde047'/%3E%3C/svg%3E">
  <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='24' fill='%239333ea'/%3E%3Ccircle cx='32' cy='38' r='9' fill='%23fde047'/%3E%3Ccircle cx='50' cy='28' r='9' fill='%23fde047'/%3E%3Ccircle cx='68' cy='38' r='9' fill='%23fde047'/%3E%3Cpath d='M50 48c-14 0-24 10-24 20 0 7 6 12 13 12 4 0 8-2 11-2s7 2 11 2c7 0 13-5 13-12 0-10-10-20-24-20z' fill='%23fde047'/%3E%3C/svg%3E">

  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { 
      font-family: 'Prompt', sans-serif; 
      background-color: #faf5ff;
      background-image: radial-gradient(#f3e8ff 1px, transparent 1px), radial-gradient(#fef9c3 1px, #faf5ff 1px);
      background-size: 40px 40px;
      background-position: 0 0, 20px 20px;
    }
    .tab-active {
      background: linear-gradient(135deg, #9333ea 0%, #a855f7 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(168, 85, 247, 0.25);
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #9333ea;
      border: 3px solid #fef08a;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(147, 51, 234, 0.35);
    }
  </style>
</head>
<body class="min-h-screen text-slate-800 pb-14">

  <!-- Header -->
  <header class="bg-white/90 backdrop-blur-md border-b border-purple-100 sticky top-0 z-50 shadow-sm">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="bg-gradient-to-br from-purple-500 to-purple-600 text-yellow-200 p-2 rounded-2xl shadow-md shadow-purple-200">
          <i data-lucide="paw-print" class="w-6 h-6"></i>
        </div>
        <div>
          <h1 class="text-xl font-bold text-purple-900 tracking-tight leading-none">Pawtion</h1>
          <p class="text-xs text-purple-500 font-medium mt-0.5">Smart Pet Calorie & Portion</p>
        </div>
      </div>
      <div class="bg-yellow-100/90 border border-yellow-200 text-purple-900 text-xs px-3 py-1.5 rounded-full font-semibold flex items-center gap-1.5 shadow-sm">
        <i data-lucide="shield-check" class="w-4 h-4 text-purple-600"></i>
        <span>สำหรับสัตว์เลี้ยงสุขภาพดี</span>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 mt-6 grid grid-cols-1 md:grid-cols-12 gap-6">

    <!-- Left Column: Inputs -->
    <div class="md:col-span-7 space-y-6">

      <!-- Healthy Pet Disclaimer / Confirmation Box -->
      <div class="bg-white p-5 rounded-3xl shadow-sm border border-purple-100 relative overflow-hidden">
        <div class="absolute -right-4 -bottom-4 text-purple-100 opacity-60 pointer-events-none">
          <i data-lucide="heart-pulse" class="w-28 h-28"></i>
        </div>
        <div class="relative z-10 space-y-3">
          <div class="flex items-start gap-3">
            <div class="p-2 bg-yellow-100 text-purple-700 rounded-xl mt-0.5 shrink-0">
              <i data-lucide="alert-circle" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="font-semibold text-purple-950 text-sm">ข้อตกลงและการยืนยันสุขภาพสัตว์เลี้ยง</h3>
              <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                สูตรคำนวณในโปรแกรมนี้ออกแบบมาสำหรับ<b class="text-purple-700">สัตว์เลี้ยงที่มีสุขภาพดีปกติเท่านั้น</b> หากน้องแมวหรือสุนัขมีโรคประจำตัว (เช่น โรคไต เบาหวาน โรคตับ หรืออยู่ในช่วงพักฟื้น) ควรปรึกษาสัตวแพทย์เพื่อกำหนดปริมาณอาหารเฉพาะโรค
              </p>
            </div>
          </div>
          <label class="flex items-center gap-2.5 p-3 bg-yellow-50/90 rounded-2xl border border-yellow-200/80 cursor-pointer transition hover:bg-yellow-100/70">
            <input type="checkbox" id="healthConfirmed" class="w-4 h-4 accent-purple-600 rounded border-purple-300 cursor-pointer" onchange="calculatePortion()">
            <span class="text-xs font-semibold text-purple-900">ยืนยันว่าสัตว์เลี้ยงมีสุขภาพดีปกติ และรับทราบเงื่อนไขดังกล่าว</span>
          </label>
        </div>
      </div>

      <!-- Main Form -->
      <div class="bg-white p-6 rounded-3xl shadow-sm border border-purple-100 space-y-5">
        
        <!-- Species Selector -->
        <div>
          <label class="block text-xs font-semibold text-purple-700 mb-2 uppercase tracking-wider">ชนิดสัตว์เลี้ยง</label>
          <div class="grid grid-cols-2 gap-2.5 p-1.5 bg-purple-50/80 rounded-2xl border border-purple-100">
            <button type="button" id="btnCat" onclick="selectSpecies('cat')" class="py-2.5 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition tab-active">
              <i data-lucide="cat" class="w-5 h-5"></i> แมว (Cat)
            </button>
            <button type="button" id="btnDog" onclick="selectSpecies('dog')" class="py-2.5 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition text-purple-700 hover:bg-purple-100/60">
              <i data-lucide="dog" class="w-5 h-5"></i> สุนัข (Dog)
            </button>
          </div>
        </div>

        <!-- Name & Weight & Age -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">ชื่อสัตว์เลี้ยง</label>
            <input type="text" id="petName" value="น้องม่อน" oninput="updatePetNameDisplay()" class="w-full px-3.5 py-2.5 rounded-2xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 focus:ring-2 focus:ring-purple-200 outline-none text-sm font-medium">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">น้ำหนักตัว (กก.)</label>
            <input type="number" id="petWeight" value="4.5" step="0.1" min="0.1" class="w-full px-3.5 py-2.5 rounded-2xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 focus:ring-2 focus:ring-purple-200 outline-none text-sm font-medium" oninput="calculatePortion()">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1.5">อายุ (ปี / เดือน)</label>
            <div class="grid grid-cols-2 gap-1.5">
              <input type="number" id="petAgeYears" value="2" min="0" placeholder="ปี" class="w-full px-2.5 py-2.5 rounded-2xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 focus:ring-2 focus:ring-purple-200 outline-none text-xs font-medium text-center" oninput="calculatePortion()">
              <input type="number" id="petAgeMonths" value="0" min="0" max="11" placeholder="เดือน" class="w-full px-2.5 py-2.5 rounded-2xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 focus:ring-2 focus:ring-purple-200 outline-none text-xs font-medium text-center" oninput="calculatePortion()">
            </div>
          </div>
        </div>

        <!-- Life Stage Status -->
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1.5">ช่วงวัยและระดับกิจกรรม</label>
          <select id="petStage" class="w-full px-3.5 py-2.5 rounded-2xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 focus:ring-2 focus:ring-purple-200 outline-none text-sm font-medium" onchange="calculatePortion()">
          </select>
        </div>

        <hr class="border-purple-50">

        <!-- Calorie Split Rule 90% Main / 10% Treats -->
        <div class="bg-gradient-to-br from-purple-50/90 to-yellow-50/80 p-4 rounded-2xl border border-purple-100 space-y-3">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <span class="text-xs font-bold text-purple-900 uppercase tracking-wider flex items-center gap-1.5">
              <i data-lucide="pie-chart" class="w-4 h-4 text-purple-600"></i> สัดส่วนแคลอรีประจำวัน
            </span>
            <span class="text-xs bg-yellow-200 text-purple-900 font-bold px-2.5 py-0.5 rounded-full shadow-xs">กฎโภชนาการ 90 / 10</span>
          </div>
          <p class="text-xs text-slate-600">
            อาหารหลัก (แห้ง/เปียก) คิดเป็น <b class="text-purple-700">90%</b> และโควต้าขนมคิดเป็น <b class="text-amber-600">10%</b> ของพลังงานรวมทั้งหมดต่อวัน
          </p>
          
          <!-- Slider Main Food vs Wet Food Ratio -->
          <div class="pt-2">
            <div class="flex justify-between text-xs font-semibold mb-2">
              <span class="text-purple-700">อาหารแห้ง (Dry): <b id="dryRatioVal">70%</b></span>
              <span class="text-amber-600">อาหารเปียก (Wet): <b id="wetRatioVal">30%</b></span>
            </div>
            <input type="range" id="mainFoodRatio" min="0" max="100" value="70" class="w-full h-2 bg-purple-200 rounded-lg appearance-none cursor-pointer" oninput="updateFoodRatioLabel(); calculatePortion();">
            <p class="text-[11px] text-slate-500 mt-1.5">*เลื่อนปรับสัดส่วนระหว่างอาหารเม็ดและอาหารเปียกภายในโควต้าอาหารหลัก 90%</p>
          </div>
        </div>

        <!-- Food Calorie Densities -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 mb-1">อาหารแห้ง (kcal/g)</label>
            <input type="number" id="dryCal" value="3.8" step="0.1" min="0.1" class="w-full px-3 py-2 rounded-xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 outline-none text-xs font-medium" oninput="calculatePortion()">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 mb-1">อาหารเปียก (kcal/g)</label>
            <input type="number" id="wetCal" value="0.85" step="0.05" min="0.1" class="w-full px-3 py-2 rounded-xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 outline-none text-xs font-medium" oninput="calculatePortion()">
          </div>
          <div>
            <label class="block text-[11px] font-semibold text-slate-600 mb-1">จำนวนมื้อ / วัน</label>
            <select id="mealsPerDay" class="w-full px-3 py-2 rounded-xl border border-purple-100 bg-purple-50/30 focus:bg-white focus:border-purple-400 outline-none text-xs font-medium" onchange="calculatePortion()">
              <option value="2">2 มื้อ</option>
              <option value="3" selected>3 มื้อ</option>
              <option value="4">4 มื้อ</option>
            </select>
          </div>
        </div>

      </div>

    </div>

    <!-- Right Column: Results -->
    <div class="md:col-span-5 space-y-5">
      
      <!-- Lock Overlay if unconfirmed -->
      <div id="unconfirmedNotice" class="bg-white border-2 border-dashed border-purple-200 p-7 rounded-3xl text-center space-y-3 shadow-sm">
        <div class="w-14 h-14 bg-yellow-100 text-purple-600 rounded-2xl flex items-center justify-center mx-auto shadow-xs">
          <i data-lucide="lock" class="w-7 h-7"></i>
        </div>
        <h4 class="font-bold text-purple-950 text-sm">กรุณากดยืนยันสุขภาพสัตว์เลี้ยง</h4>
        <p class="text-xs text-slate-500 leading-relaxed">ติ๊กช่องยืนยันว่า <span id="lockPetName" class="font-semibold text-purple-700">น้องม่อน</span> มีสุขภาพดีปกติในกล่องด้านซ้ายมือ เพื่อแสดงผลการคำนวณแคลอรีและปริมาณอาหาร</p>
      </div>

      <!-- Result Card -->
      <div id="resultCard" class="hidden space-y-5">

        <!-- Total Energy Banner -->
        <div class="bg-gradient-to-br from-purple-600 via-purple-500 to-indigo-500 text-white p-6 rounded-3xl shadow-lg shadow-purple-200/70 space-y-4 relative overflow-hidden">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs font-medium text-purple-100 uppercase tracking-wider">แคลอรีรวมต่อวันของ <span id="resPetName" class="text-yellow-200 font-bold">น้องม่อน</span></p>
              <h2 class="text-3xl font-extrabold mt-1 text-yellow-200"><span id="resDER">0</span> <span class="text-base font-semibold text-white">kcal/วัน</span></h2>
            </div>
            <span class="bg-white/15 text-yellow-100 text-xs px-2.5 py-1 rounded-full border border-white/20 font-medium">RER: <span id="resRER">0</span></span>
          </div>

          <!-- Breakdown 90/10 -->
          <div class="grid grid-cols-2 gap-2.5 pt-2 border-t border-white/15 text-xs">
            <div class="bg-white/15 p-3 rounded-2xl backdrop-blur-xs">
              <p class="text-purple-100">อาหารหลัก (90%)</p>
              <p class="font-bold text-sm mt-0.5 text-white"><span id="resMainCal">0</span> kcal</p>
            </div>
            <div class="bg-yellow-300/20 border border-yellow-200/30 p-3 rounded-2xl backdrop-blur-xs">
              <p class="text-yellow-100">โควต้าขนม (10%)</p>
              <p class="font-bold text-sm mt-0.5 text-yellow-200"><span id="resTreatCal">0</span> kcal</p>
            </div>
          </div>
        </div>

        <!-- Portion Breakdown -->
        <div class="bg-white p-5 rounded-3xl shadow-sm border border-purple-100 space-y-4">
          <h3 class="font-bold text-purple-950 text-sm flex items-center gap-2">
            <i data-lucide="utensils" class="w-4 h-4 text-purple-600"></i> ปริมาณอาหารแนะนำต่อวัน
          </h3>

          <div class="space-y-3">
            <!-- Dry Food Portion -->
            <div class="flex items-center justify-between p-3.5 bg-purple-50/70 rounded-2xl border border-purple-100">
              <div class="flex items-center gap-3">
                <div class="p-2.5 bg-purple-100 text-purple-700 rounded-xl">
                  <i data-lucide="cookie" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="font-semibold text-xs text-purple-950">อาหารแห้ง (เม็ด)</p>
                  <p class="text-[11px] text-slate-500"><span id="resDryCal">0</span> kcal/วัน</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-base font-extrabold text-purple-700"><span id="resDryGram">0</span> g</span>
                <p class="text-[10px] text-slate-400">ต่อวัน</p>
              </div>
            </div>

            <!-- Wet Food Portion -->
            <div class="flex items-center justify-between p-3.5 bg-yellow-50/80 rounded-2xl border border-yellow-200/70">
              <div class="flex items-center gap-3">
                <div class="p-2.5 bg-yellow-100 text-amber-700 rounded-xl">
                  <i data-lucide="soup" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="font-semibold text-xs text-purple-950">อาหารเปียก</p>
                  <p class="text-[11px] text-slate-500"><span id="resWetCal">0</span> kcal/วัน</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-base font-extrabold text-amber-600"><span id="resWetGram">0</span> g</span>
                <p class="text-[10px] text-slate-400">ต่อวัน</p>
              </div>
            </div>

            <!-- Treats Portion -->
            <div class="flex items-center justify-between p-3.5 bg-fuchsia-50/60 rounded-2xl border border-fuchsia-100">
              <div class="flex items-center gap-3">
                <div class="p-2.5 bg-fuchsia-100 text-fuchsia-700 rounded-xl">
                  <i data-lucide="gift" class="w-5 h-5"></i>
                </div>
                <div>
                  <p class="font-semibold text-xs text-purple-950">ขนม / ของทานเล่น</p>
                  <p class="text-[11px] text-slate-500">จำกัดไม่เกิน 10%</p>
                </div>
              </div>
              <div class="text-right">
                <span class="text-base font-extrabold text-fuchsia-600"><span id="resTreatMaxCal">0</span> kcal</span>
                <p class="text-[10px] text-slate-400">ต่อวัน</p>
              </div>
            </div>

          </div>
        </div>

        <!-- Meal Schedule Split -->
        <div class="bg-white p-5 rounded-3xl shadow-sm border border-purple-100 space-y-3">
          <h3 class="font-bold text-purple-950 text-sm flex items-center gap-2">
            <i data-lucide="clock" class="w-4 h-4 text-purple-600"></i> สรุปการแบ่งมื้ออาหาร (<span id="resMealCount">3</span> มื้อ/วัน)
          </h3>
          <div class="p-3.5 bg-purple-50/50 rounded-2xl border border-purple-100 text-xs text-slate-600 space-y-1.5">
            <div class="flex justify-between">
              <span>อาหารแห้งต่อมื้อ:</span>
              <b class="text-purple-700"><span id="resDryPerMeal">0</span> g</b>
            </div>
            <div class="flex justify-between">
              <span>อาหารเปียกต่อมื้อ:</span>
              <b class="text-amber-600"><span id="resWetPerMeal">0</span> g</b>
            </div>
          </div>
        </div>

        <!-- Water Needs -->
        <div class="bg-yellow-50/90 p-4 rounded-3xl border border-yellow-200/80 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="p-2.5 bg-yellow-200/70 text-purple-700 rounded-2xl">
              <i data-lucide="droplets" class="w-5 h-5"></i>
            </div>
            <div>
              <p class="font-bold text-xs text-purple-950">ปริมาณน้ำดื่มที่ควรได้รับ</p>
              <p class="text-[11px] text-slate-500">ดูแลระบบทางเดินปัสสาวะและไต</p>
            </div>
          </div>
          <span class="text-sm font-extrabold text-purple-700"><span id="resWater">0</span> ml/วัน</span>
        </div>

      </div>

    </div>

  </main>

  <script>
    lucide.createIcons();

    let currentSpecies = 'cat';

    const catStages = [
      { id: 'cat_kitten', label: 'ลูกแมว (อายุต่ำกว่า 1 ปี) [DER = 2.5 x RER]', factor: 2.5 },
      { id: 'cat_neutered', label: 'แมวโตทำหมันแล้ว (กิจกรรมปกติ) [DER = 1.2 x RER]', factor: 1.2 },
      { id: 'cat_intact', label: 'แมวโตยังไม่ทำหมัน [DER = 1.4 x RER]', factor: 1.4 },
      { id: 'cat_weight_loss', label: 'แมวโตลดน้ำหนัก / กิจกรรมน้อย [DER = 1.0 x RER]', factor: 1.0 },
      { id: 'cat_senior', label: 'แมวสูงวัย (7 ปีขึ้นไป) [DER = 1.1 x RER]', factor: 1.1 },
      { id: 'cat_pregnant', label: 'แมวตั้งท้อง / ให้นมลูก [DER = 2.0 x RER]', factor: 2.0 }
    ];

    const dogStages = [
      { id: 'dog_puppy_4m', label: 'ลูกสุนัข (อายุต่ำกว่า 4 เดือน) [DER = 3.0 x RER]', factor: 3.0 },
      { id: 'dog_puppy_4m_plus', label: 'ลูกสุนัข (อายุ 4 เดือน - 1 ปี) [DER = 2.0 x RER]', factor: 2.0 },
      { id: 'dog_neutered', label: 'สุนัขโตทำหมันแล้ว [DER = 1.6 x RER]', factor: 1.6 },
      { id: 'dog_intact', label: 'สุนัขโตยังไม่ทำหมัน [DER = 1.8 x RER]', factor: 1.8 },
      { id: 'dog_active', label: 'สุนัขแอคทีฟ / ออกกำลังกายเยอะ [DER = 2.0 x RER]', factor: 2.0 },
      { id: 'dog_weight_loss', label: 'สุนัขลดน้ำหนัก [DER = 1.0 x RER]', factor: 1.0 },
      { id: 'dog_senior', label: 'สุนัขสูงวัย [DER = 1.2 x RER]', factor: 1.2 }
    ];

    function updatePetNameDisplay() {
      const name = document.getElementById('petName').value.trim() || 'สัตว์เลี้ยงของคุณ';
      document.getElementById('lockPetName').textContent = name;
      document.getElementById('resPetName').textContent = name;
    }

    function selectSpecies(species) {
      currentSpecies = species;
      const btnCat = document.getElementById('btnCat');
      const btnDog = document.getElementById('btnDog');

      if (species === 'cat') {
        btnCat.className = 'py-2.5 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition tab-active';
        btnDog.className = 'py-2.5 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition text-purple-700 hover:bg-purple-100/60';
      } else {
        btnDog.className = 'py-2.5 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition tab-active';
        btnCat.className = 'py-2.5 px-4 rounded-xl font-medium text-sm flex items-center justify-center gap-2 transition text-purple-700 hover:bg-purple-100/60';
      }

      populateStages();
      calculatePortion();
    }

    function populateStages() {
      const stageSelect = document.getElementById('petStage');
      stageSelect.innerHTML = '';
      const list = currentSpecies === 'cat' ? catStages : dogStages;

      list.forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.factor;
        opt.textContent = item.label;
        stageSelect.appendChild(opt);
      });
    }

    function updateFoodRatioLabel() {
      const dryVal = document.getElementById('mainFoodRatio').value;
      const wetVal = 100 - dryVal;
      document.getElementById('dryRatioVal').textContent = dryVal + '%';
      document.getElementById('wetRatioVal').textContent = wetVal + '%';
    }

    function calculatePortion() {
      const isConfirmed = document.getElementById('healthConfirmed').checked;
      const notice = document.getElementById('unconfirmedNotice');
      const resultCard = document.getElementById('resultCard');

      if (!isConfirmed) {
        notice.classList.remove('hidden');
        resultCard.classList.add('hidden');
        return;
      } else {
        notice.classList.add('hidden');
        resultCard.classList.remove('hidden');
      }

      const weight = parseFloat(document.getElementById('petWeight').value) || 0;
      if (weight <= 0) return;

      const factor = parseFloat(document.getElementById('petStage').value) || 1.2;
      
      // RER = 70 * (weight ^ 0.75)
      const rer = 70 * Math.pow(weight, 0.75);
      const der = rer * factor;

      // 90% Main Food, 10% Treats
      const mainFoodCal = der * 0.90;
      const treatCal = der * 0.10;

      // Main Food Ratio Split (Dry vs Wet)
      const dryRatioPct = parseFloat(document.getElementById('mainFoodRatio').value) / 100;
      const wetRatioPct = 1 - dryRatioPct;

      const dryCalTarget = mainFoodCal * dryRatioPct;
      const wetCalTarget = mainFoodCal * wetRatioPct;

      // Densities
      const dryDensity = parseFloat(document.getElementById('dryCal').value) || 3.8;
      const wetDensity = parseFloat(document.getElementById('wetCal').value) || 0.85;

      const dryGrams = dryCalTarget / dryDensity;
      const wetGrams = wetCalTarget / wetDensity;

      // Meals
      const meals = parseInt(document.getElementById('mealsPerDay').value) || 3;
      const dryPerMeal = dryGrams / meals;
      const wetPerMeal = wetGrams / meals;

      // Water intake estimation
      const waterFactor = currentSpecies === 'cat' ? 50 : 60;
      const waterMl = weight * waterFactor;

      // Render UI
      document.getElementById('resRER').textContent = Math.round(rer);
      document.getElementById('resDER').textContent = Math.round(der);
      document.getElementById('resMainCal').textContent = Math.round(mainFoodCal);
      document.getElementById('resTreatCal').textContent = Math.round(treatCal);

      document.getElementById('resDryCal').textContent = Math.round(dryCalTarget);
      document.getElementById('resDryGram').textContent = dryGrams.toFixed(1);

      document.getElementById('resWetCal').textContent = Math.round(wetCalTarget);
      document.getElementById('resWetGram').textContent = wetGrams.toFixed(1);

      document.getElementById('resTreatMaxCal').textContent = Math.round(treatCal);

      document.getElementById('resMealCount').textContent = meals;
      document.getElementById('resDryPerMeal').textContent = dryPerMeal.toFixed(1);
      document.getElementById('resWetPerMeal').textContent = wetPerMeal.toFixed(1);

      document.getElementById('resWater').textContent = Math.round(waterMl);
    }

    // Initial setup
    populateStages();
    updatePetNameDisplay();
    calculatePortion();
  </script>
</body>
</html>
