<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pawtion - Pet Calorie & Portion Calculator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Prompt & Mitr -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Mitr:wght@400;500;600&family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        pawtion: {
                            purple: '#9B87E8',
                            purpleDark: '#7C65D6',
                            purpleLight: '#F3EFFE',
                            purpleBorder: '#E0D7FC',
                            yellow: '#F9D976',
                            yellowHover: '#F7CE51',
                            yellowLight: '#FFF9E6',
                            yellowBorder: '#FDEAA6',
                            textDark: '#3A334B',
                            dogBlue: '#6C9BF1',
                            dogLightBlue: '#EEF4FF',
                            treatPink: '#FF8DB3'
                        }
                    },
                    fontFamily: {
                        prompt: ['Prompt', 'sans-serif'],
                        mitr: ['Mitr', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Prompt', sans-serif;
            background-color: #F8F5FF;
            color: #3A334B;
        }
        h1, h2, h3, h4, .font-title {
            font-family: 'Mitr', sans-serif;
        }
        .custom-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #9B87E8;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(155, 135, 232, 0.4);
            transition: transform 0.1s ease;
        }
        .custom-slider::-webkit-slider-thumb:hover {
            transform: scale(1.15);
        }
        .avatar-option.selected {
            border-color: #9B87E8;
            background-color: #F3EFFE;
            transform: scale(1.05);
        }
        .species-btn.active-cat {
            background-color: #9B87E8;
            color: white;
            border-color: #9B87E8;
            box-shadow: 0 4px 12px rgba(155, 135, 232, 0.35);
        }
        .species-btn.active-dog {
            background-color: #6C9BF1;
            color: white;
            border-color: #6C9BF1;
            box-shadow: 0 4px 12px rgba(108, 155, 241, 0.35);
        }
    </style>
</head>
<body class="min-h-screen pb-12">

    <!-- Header / Navbar -->
    <header class="bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-purple-100 shadow-sm">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div id="brandLogoBg" class="w-10 h-10 rounded-2xl bg-pawtion-purple flex items-center justify-center text-white text-xl shadow-md transition-colors duration-300">
                    <i id="brandLogoIcon" class="fa-solid fa-paw text-pawtion-yellow"></i>
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-pawtion-textDark tracking-tight leading-none">Pawtion</h1>
                    <p class="text-[11px] text-pawtion-purpleDark font-medium">Pet Calorie & Portion Calculator</p>
                </div>
            </div>
            
            <div class="flex items-center gap-2">
                <span class="text-xs px-2.5 py-1 rounded-full bg-purple-50 text-pawtion-purpleDark border border-pawtion-purpleBorder font-medium">
                    <i class="fa-solid fa-shield-heart text-pawtion-purple mr-1"></i> สำหรับสัตว์เลี้ยงสุขภาพดี
                </span>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-4xl mx-auto px-4 pt-6 space-y-6">

        <!-- Banner -->
        <section id="heroBanner" class="bg-gradient-to-r from-pawtion-purple to-purple-400 text-white rounded-3xl p-6 shadow-lg relative overflow-hidden transition-all duration-300">
            <div class="relative z-10 max-w-lg">
                <div class="inline-flex items-center gap-1.5 bg-pawtion-yellow text-pawtion-textDark text-xs px-3 py-1 rounded-full font-bold shadow-sm mb-2">
                    <i class="fa-solid fa-scale-balanced"></i> กฏโภชนาการ 90/10 (อาหารหลัก 90% + ขนม 10%)
                </div>
                <h2 class="text-2xl md:text-3xl font-bold mb-2">คำนวณมื้ออร่อย พอดีเป๊ะให้เพื่อนสี่ขา 🐾</h2>
                <p class="text-purple-100 text-xs md:text-sm leading-relaxed">
                    เพราะสุขภาพที่ดีเริ่มจากปริมาณอาหารที่ถูกต้อง คำนวณพลังงาน (DER) สำหรับแมวและสุนัขสุขภาพดี เพื่อหุ่นสมส่วนและอายุยืนยาว
                </p>
            </div>
            <div class="absolute -right-6 -bottom-8 opacity-20 text-9xl text-white pointer-events-none">
                <i id="bannerBgIcon" class="fa-solid fa-cat"></i>
            </div>
        </section>

        <!-- Healthy Pet Confirmation Box (Mandatory Checkbox) -->
        <section class="bg-pawtion-yellowLight border-2 border-pawtion-yellowBorder rounded-2xl p-4 shadow-sm space-y-2">
            <div class="flex items-start gap-3">
                <input type="checkbox" id="healthConfirm" onchange="toggleHealthConfirmation()" 
                    class="mt-1 w-5 h-5 text-pawtion-purple rounded border-purple-300 focus:ring-pawtion-purple cursor-pointer">
                <label for="healthConfirm" class="text-xs sm:text-sm text-pawtion-textDark cursor-pointer leading-relaxed">
                    <span class="font-bold text-amber-900">ยืนยันข้อมูลสุขภาพสัตว์เลี้ยง:</span> 
                    ฉันยืนยันว่าสัตว์เลี้ยงตัวนี้<span class="font-bold underline text-pawtion-purpleDark">มีสุขภาพแข็งแรงดี</span> ไม่อยู่ระหว่างการรักษาโรคเรื้อรัง (เช่น โรคไต, โรคเบาหวาน, โรคตับ หรือโรคหัวใจ) ซึ่งต้องการอาหารเฉพาะทางทางการแพทย์
                </label>
            </div>
            <p id="healthWarning" class="text-[11px] text-purple-600 font-medium pl-8">
                * กรุณาทำเครื่องหมายยืนยัน เพื่อปลดล็อกการคำนวณปริมาณอาหาร
            </p>
        </section>

        <!-- Main Workspace (Form & Results) -->
        <div id="calculatorBody" class="grid grid-cols-1 lg:grid-cols-12 gap-6 opacity-50 pointer-events-none transition-all duration-300">

            <!-- Left Column: Form Inputs -->
            <div class="lg:col-span-7 bg-white rounded-3xl p-6 shadow-md border border-purple-100 space-y-6">
                
                <!-- 1. Species Selection -->
                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">1. เลือกชนิดสัตว์เลี้ยง</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" id="btnCat" onclick="setSpecies('cat')" 
                            class="species-btn active-cat py-3 px-4 rounded-2xl border text-sm font-bold flex items-center justify-center gap-2 transition duration-200">
                            <i class="fa-solid fa-cat text-lg"></i> แมว (Cat)
                        </button>
                        <button type="button" id="btnDog" onclick="setSpecies('dog')" 
                            class="species-btn py-3 px-4 rounded-2xl border border-gray-200 text-gray-600 hover:border-pawtion-dogBlue text-sm font-bold flex items-center justify-center gap-2 transition duration-200">
                            <i class="fa-solid fa-dog text-lg"></i> สุนัข (Dog)
                        </button>
                    </div>
                </div>

                <!-- 2. Pet Profile (Name, Avatar, Age) -->
                <div class="space-y-3">
                    <label class="block text-sm font-semibold text-gray-700">2. ข้อมูลทั่วไปของสัตว์เลี้ยง</label>
                    
                    <div class="flex gap-3">
                        <input type="text" id="petName" value="น้องส้มหยุด" placeholder="ชื่อสัตว์เลี้ยง..." 
                            class="flex-1 px-4 py-2.5 rounded-2xl border border-purple-100 focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50 text-sm transition">
                    </div>

                    <!-- Avatars (Dynamic per species) -->
                    <div id="avatarContainer" class="flex justify-between items-center gap-2 pt-1">
                        <!-- JS inserted avatars -->
                    </div>

                    <!-- Age Input (Years & Months) -->
                    <div class="grid grid-cols-2 gap-3 pt-1">
                        <div>
                            <label class="block text-xs text-gray-500 mb-1">อายุ (ปี)</label>
                            <input type="number" id="petAgeYears" min="0" max="30" value="2" 
                                class="w-full px-3 py-2 rounded-xl border border-purple-100 focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50 text-sm font-semibold"
                                oninput="calculatePawtion()">
                        </div>
                        <div>
                            <label class="block text-xs text-gray-500 mb-1">อายุ (เดือน)</label>
                            <input type="number" id="petAgeMonths" min="0" max="11" value="6" 
                                class="w-full px-3 py-2 rounded-xl border border-purple-100 focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50 text-sm font-semibold"
                                oninput="calculatePawtion()">
                        </div>
                    </div>
                </div>

                <!-- 3. Weight & Life Stage -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Weight Input -->
                    <div class="space-y-1.5">
                        <label for="petWeight" class="block text-sm font-semibold text-gray-700">
                            3. น้ำหนักตัว (kg)
                        </label>
                        <div class="relative">
                            <input type="number" id="petWeight" step="0.1" min="0.2" max="100" value="4.0" 
                                class="w-full px-4 py-2.5 rounded-2xl border border-purple-100 focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50 text-base font-bold text-pawtion-textDark"
                                oninput="calculatePawtion()">
                            <span class="absolute right-4 top-3 text-xs text-gray-400 font-normal">กิโลกรัม</span>
                        </div>
                    </div>

                    <!-- Life Stage / Activity Level (Dynamic options) -->
                    <div class="space-y-1.5">
                        <label for="lifeStage" class="block text-sm font-semibold text-gray-700">
                            4. ช่วงวัยและกิจกรรม
                        </label>
                        <select id="lifeStage" onchange="calculatePawtion()" 
                            class="w-full px-3 py-2.5 rounded-2xl border border-purple-100 focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50 bg-white text-xs sm:text-sm">
                            <!-- JS populate options -->
                        </select>
                    </div>
                </div>

                <!-- 4. Main Food Type & Slider Ratio -->
                <div class="space-y-3 pt-2 border-t border-purple-50">
                    <div class="flex justify-between items-center">
                        <label class="block text-sm font-semibold text-gray-700">
                            5. จัดสัดส่วนอาหารหลัก (โควต้า 90%)
                        </label>
                        <span id="mainRatioDisplay" class="text-xs font-bold text-pawtion-purpleDark">อาหารแห้ง 70% : เปียก 30%</span>
                    </div>

                    <!-- Slider for Main Dry vs Main Wet -->
                    <div class="bg-pawtion-purpleLight p-4 rounded-2xl border border-purple-100 space-y-2">
                        <input type="range" id="dryRatio" min="0" max="100" value="70" step="5" 
                            class="w-full h-2 bg-purple-200 rounded-lg appearance-none cursor-pointer custom-slider"
                            oninput="updateRatioDisplay(); calculatePawtion();">
                        <div class="flex justify-between text-[11px] text-gray-500 font-light">
                            <span>เน้นอาหารเปียก (100%)</span>
                            <span>เน้นอาหารแห้ง/เม็ด (100%)</span>
                        </div>
                    </div>
                </div>

                <!-- 5. Caloric Densities Inputs -->
                <div class="space-y-3">
                    <div class="flex justify-between items-center">
                        <label class="block text-sm font-semibold text-gray-700">6. ค่าพลังงานของอาหารที่ใช้</label>
                        <button type="button" onclick="resetCalorieDefaults()" class="text-xs text-pawtion-purpleDark font-semibold underline hover:text-purple-900">
                            คืนค่ามาตรฐาน
                        </button>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <!-- Dry Food Density -->
                        <div class="space-y-1">
                            <span class="text-xs text-gray-500">อาหารแห้ง/เม็ด (kcal / 100g)</span>
                            <input type="number" id="dryCalPer100g" value="380" step="5" min="100" max="600" 
                                class="w-full px-3 py-2 rounded-xl border border-purple-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50"
                                oninput="calculatePawtion()">
                        </div>

                        <!-- Wet Food Density -->
                        <div class="space-y-1">
                            <span class="text-xs text-gray-500">อาหารเปียก (kcal / 100g)</span>
                            <input type="number" id="wetCalPer100g" value="90" step="5" min="30" max="300" 
                                class="w-full px-3 py-2 rounded-xl border border-purple-100 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-pawtion-purple/50"
                                oninput="calculatePawtion()">
                        </div>
                    </div>
                </div>

                <!-- 6. Meals Per Day -->
                <div class="space-y-2">
                    <label class="block text-sm font-semibold text-gray-700">7. แบ่งให้อาหารกี่มื้อต่อวัน?</label>
                    <div class="flex items-center gap-4 text-xs sm:text-sm">
                        <label class="inline-flex items-center gap-1.5 text-gray-600 cursor-pointer">
                            <input type="radio" name="mealsPerDay" value="2" checked onchange="calculatePawtion()" class="text-pawtion-purple focus:ring-pawtion-purple"> 2 มื้อ
                        </label>
                        <label class="inline-flex items-center gap-1.5 text-gray-600 cursor-pointer">
                            <input type="radio" name="mealsPerDay" value="3" onchange="calculatePawtion()" class="text-pawtion-purple focus:ring-pawtion-purple"> 3 มื้อ
                        </label>
                        <label class="inline-flex items-center gap-1.5 text-gray-600 cursor-pointer">
                            <input type="radio" name="mealsPerDay" value="4" onchange="calculatePawtion()" class="text-pawtion-purple focus:ring-pawtion-purple"> 4 มื้อ
                        </label>
                    </div>
                </div>

            </div>

            <!-- Right Column: Results Summary -->
            <div class="lg:col-span-5 space-y-6">

                <div class="bg-gradient-to-b from-white to-purple-50/60 rounded-3xl p-6 shadow-md border border-purple-100 relative space-y-5">
                    
                    <!-- Result Card Header -->
                    <div class="flex items-center justify-between border-b border-purple-100 pb-3">
                        <div class="flex items-center gap-3">
                            <span id="resAvatar" class="text-3xl">🐱</span>
                            <div>
                                <h3 id="resPetName" class="font-bold text-lg text-pawtion-textDark">น้องส้มหยุด</h3>
                                <p class="text-xs text-gray-500" id="resSummarySubtitle">แมว • อายุ 2 ปี 6 เดือน • 4.0 kg</p>
                            </div>
                        </div>
                        <span id="speciesBadge" class="bg-purple-100 text-pawtion-purpleDark font-bold text-xs px-2.5 py-1 rounded-full">
                            🐱 แมว
                        </span>
                    </div>

                    <!-- Total Calorie Box -->
                    <div class="bg-gradient-to-br from-pawtion-purpleLight to-white p-4 rounded-2xl shadow-sm border border-purple-100 text-center space-y-1">
                        <span class="text-xs text-gray-500 font-medium uppercase tracking-wide">พลังงานรวมที่ต้องการต่อวัน (DER)</span>
                        <div class="flex items-baseline justify-center gap-1">
                            <span id="totalCalories" class="text-4xl font-extrabold text-pawtion-purpleDark">0</span>
                            <span class="text-xs font-semibold text-gray-500">kcal/วัน</span>
                        </div>
                        <div class="text-[11px] text-gray-400 pt-0.5" id="rerFormulaDetail">
                            (RER: 0 kcal)
                        </div>
                    </div>

                    <!-- 90 / 10 Calorie Split Breakdown -->
                    <div class="space-y-3">
                        <h4 class="text-xs font-bold text-gray-500 uppercase tracking-wider flex items-center justify-between">
                            <span>สัดส่วนโภชนาการ (90 / 10 Rule)</span>
                        </h4>

                        <!-- 90% Main Food Breakdown -->
                        <div class="bg-white p-3.5 rounded-2xl border border-purple-100 space-y-2">
                            <div class="flex justify-between items-center border-b border-purple-50 pb-2">
                                <span class="text-xs font-bold text-pawtion-textDark flex items-center gap-1.5">
                                    <i class="fa-solid fa-bowl-food text-pawtion-purple"></i> อาหารหลัก (90%)
                                </span>
                                <span id="mainCalTarget" class="text-xs font-bold text-pawtion-purpleDark">0 kcal</span>
                            </div>

                            <div class="grid grid-cols-2 gap-2 pt-1 text-xs">
                                <!-- Dry portion -->
                                <div class="bg-pawtion-yellowLight p-2.5 rounded-xl border border-pawtion-yellowBorder">
                                    <div class="text-[11px] text-gray-600">อาหารแห้ง/เม็ด</div>
                                    <div class="font-bold text-sm text-amber-900 mt-0.5">
                                        <span id="dryGramsDay">0</span> <span class="text-[10px] font-normal text-gray-500">g/วัน</span>
                                    </div>
                                </div>
                                <!-- Wet portion -->
                                <div class="bg-pawtion-purpleLight p-2.5 rounded-xl border border-purple-100">
                                    <div class="text-[11px] text-gray-600">อาหารเปียก</div>
                                    <div class="font-bold text-sm text-pawtion-purpleDark mt-0.5">
                                        <span id="wetGramsDay">0</span> <span class="text-[10px] font-normal text-gray-500">g/วัน</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 10% Treat Cap -->
                        <div class="bg-gradient-to-r from-purple-50 to-pink-50 p-3.5 rounded-2xl border border-purple-100 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="w-8 h-8 rounded-xl bg-pawtion-yellow text-pawtion-textDark flex items-center justify-center text-sm shadow-sm font-bold">
                                    <i class="fa-solid fa-cookie"></i>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-purple-900">โควต้าขนม/ทรีต (สูงสุด 10%)</div>
                                    <div class="text-[10px] text-purple-600">ไม่ควรให้เกินพลังงานส่วนนี้</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <span id="treatCalTarget" class="text-base font-extrabold text-pawtion-purpleDark">0</span>
                                <span class="text-[10px] text-gray-500 block">kcal/วัน</span>
                            </div>
                        </div>

                    </div>

                    <!-- Daily Schedule Plan -->
                    <div class="bg-pawtion-purpleLight p-4 rounded-2xl border border-purple-100 space-y-2">
                        <div class="text-xs font-bold text-pawtion-textDark flex items-center justify-between">
                            <span><i class="fa-regular fa-clock text-pawtion-purple mr-1"></i> แบ่งจ่ายอาหาร (<span id="mealCountText">2</span> มื้อ/วัน)</span>
                        </div>
                        <div class="text-xs text-gray-600 space-y-1.5 pt-1" id="mealScheduleList">
                            <!-- JS Populated Meal Plan -->
                        </div>
                    </div>

                    <!-- Water Requirement Target -->
                    <div class="bg-blue-50/80 p-3 rounded-2xl border border-blue-100 flex items-center gap-3 text-xs text-blue-900">
                        <i class="fa-solid fa-droplet text-blue-500 text-xl"></i>
                        <div>
                            <span class="font-bold">น้ำดื่มแนะนำต่อวัน:</span> ประมาณ <span id="waterReq" class="font-extrabold text-blue-600 text-sm">0</span> มล.
                            <div class="text-[10px] text-blue-400">เพื่อสุขภาพระบบขับถ่ายและไตที่ดี</div>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- Health Guide & Tip Section -->
        <section class="bg-white rounded-3xl p-6 shadow-md border border-purple-100 space-y-4">
            <h3 class="text-base font-bold text-pawtion-textDark flex items-center gap-2 border-b border-purple-100 pb-3">
                <i class="fa-solid fa-circle-info text-pawtion-purple"></i> ข้อควรรู้เรื่องโภชนาการสำหรับสัตว์เลี้ยงสุขภาพดี
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs text-gray-600 leading-relaxed">
                <div class="p-3.5 rounded-2xl bg-pawtion-yellowLight border border-pawtion-yellowBorder space-y-1">
                    <span class="font-bold text-amber-900">ทำไมต้องคุมขนมไม่เกิน 10%?</span>
                    <p>ขนมส่วนใหญ่อุดมไปด้วยแป้ง โซเดียม หรือปรุงแต่งรส หากให้เกิน 10% ของพลังงานประจำวัน จะทำให้สัตว์เลี้ยงได้รับสารอาหารหลักไม่ครบถ้วน เสี่ยงต่อภาวะโภชนาการไม่อสมดุลและโรคอ้วน</p>
                </div>

                <div class="p-3.5 rounded-2xl bg-pawtion-purpleLight border border-purple-100 space-y-1">
                    <span class="font-bold text-pawtion-purpleDark">การสังเกตน้ำหนักตัว (BCS)</span>
                    <p>ควรชั่งน้ำหนักสัตว์เลี้ยงเดือนละ 1 ครั้ง ร่วมกับการลูบดูบริเวณลำตัว หากเริ่มคลำหาซี่โครงได้ยาก ควรปรับลดปริมาณอาหารลง 5-10% และเพิ่มกิจกรรมการออกกำลังกาย</p>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="mt-12 text-center text-xs text-purple-400 space-y-1">
        <p class="font-semibold text-purple-600">Pawtion - Pet Calorie & Portion Calculator</p>
        <p class="text-[11px]">คำนวณตามมาตรฐานโภชนาการสัตว์เลี้ยง (AAFCO / WSAVA Guidelines)</p>
    </footer>

    <!-- App Logic -->
    <script>
        let currentSpecies = 'cat'; // 'cat' or 'dog'
        let selectedAvatar = '🐱';

        const catAvatars = ['🐱', '🐈', '🐈‍⬛', '🦁', '🐯'];
        const dogAvatars = ['🐶', '🐕', '🦮', '🐩', '🐕‍🦺'];

        const lifeStagesData = {
            cat: [
                { text: 'ลูกแมว (อายุ < 4 เดือน)', factor: 2.5 },
                { text: 'ลูกแมวกำลังโต (4 - 12 เดือน)', factor: 2.0 },
                { text: 'แมวโตเต็มวัย (ทำหมันแล้ว)', factor: 1.2, default: true },
                { text: 'แมวโตเต็มวัย (ยังไม่ทำหมัน)', factor: 1.4 },
                { text: 'แมวเริ่มอ้วน / กิจกรรมน้อย', factor: 1.0 },
                { text: 'แมวลดน้ำหนัก (คุมอาหาร)', factor: 0.8 },
                { text: 'แมวสูงวัย (7 ปีขึ้นไป)', factor: 1.1 },
                { text: 'แมวตั้งท้อง / ให้นม', factor: 2.2 }
            ],
            dog: [
                { text: 'ลูกสุนัข (อายุ < 4 เดือน)', factor: 3.0 },
                { text: 'ลูกสุนัขกำลังโต (4 - 12 เดือน)', factor: 2.0 },
                { text: 'สุนัขโตเต็มวัย (ทำหมันแล้ว)', factor: 1.6, default: true },
                { text: 'สุนัขโตเต็มวัย (ยังไม่ทำหมัน)', factor: 1.8 },
                { text: 'สุนัขกิจกรรมสูง / ออกกำลังกายเยอะ', factor: 2.0 },
                { text: 'สุนัขกิจกรรมน้อย / แนวโน้มอ้วนง่าย', factor: 1.2 },
                { text: 'สุนัขลดน้ำหนัก (คุมอาหาร)', factor: 1.0 },
                { text: 'สุนัขสูงวัย (7 ปีขึ้นไป)', factor: 1.4 },
                { text: 'สุนัขตั้งท้อง / ให้นม', factor: 3.0 }
            ]
        };

        // Enable / Disable Form based on Health Confirmation
        function toggleHealthConfirmation() {
            const isChecked = document.getElementById('healthConfirm').checked;
            const calcBody = document.getElementById('calculatorBody');
            const warningText = document.getElementById('healthWarning');

            if (isChecked) {
                calcBody.classList.remove('opacity-50', 'pointer-events-none');
                warningText.classList.add('hidden');
                calculatePawtion();
            } else {
                calcBody.classList.add('opacity-50', 'pointer-events-none');
                warningText.classList.remove('hidden');
            }
        }

        // Species Switcher (Cat vs Dog)
        function setSpecies(species) {
            currentSpecies = species;
            const btnCat = document.getElementById('btnCat');
            const btnDog = document.getElementById('btnDog');
            const brandLogoBg = document.getElementById('brandLogoBg');
            const brandLogoIcon = document.getElementById('brandLogoIcon');
            const heroBanner = document.getElementById('heroBanner');
            const bannerBgIcon = document.getElementById('bannerBgIcon');
            const speciesBadge = document.getElementById('speciesBadge');

            if (species === 'cat') {
                btnCat.className = 'species-btn active-cat py-3 px-4 rounded-2xl border text-sm font-bold flex items-center justify-center gap-2 transition duration-200';
                btnDog.className = 'species-btn py-3 px-4 rounded-2xl border border-gray-200 text-gray-600 hover:border-pawtion-dogBlue text-sm font-bold flex items-center justify-center gap-2 transition duration-200';
                
                brandLogoBg.className = 'w-10 h-10 rounded-2xl bg-pawtion-purple flex items-center justify-center text-white text-xl shadow-md transition-colors duration-300';
                brandLogoIcon.className = 'fa-solid fa-cat text-pawtion-yellow';

                heroBanner.className = 'bg-gradient-to-r from-pawtion-purple to-purple-400 text-white rounded-3xl p-6 shadow-lg relative overflow-hidden transition-all duration-300';
                bannerBgIcon.className = 'fa-solid fa-cat';

                speciesBadge.className = 'bg-purple-100 text-pawtion-purpleDark font-bold text-xs px-2.5 py-1 rounded-full';
                speciesBadge.innerHTML = '🐱 แมว';

                document.getElementById('petName').value = 'น้องส้มหยุด';
            } else {
                btnDog.className = 'species-btn active-dog py-3 px-4 rounded-2xl border text-sm font-bold flex items-center justify-center gap-2 transition duration-200';
                btnCat.className = 'species-btn py-3 px-4 rounded-2xl border border-gray-200 text-gray-600 hover:border-pawtion-purple text-sm font-bold flex items-center justify-center gap-2 transition duration-200';
                
                brandLogoBg.className = 'w-10 h-10 rounded-2xl bg-pawtion-dogBlue flex items-center justify-center text-white text-xl shadow-md transition-colors duration-300';
                brandLogoIcon.className = 'fa-solid fa-dog text-pawtion-yellow';

                heroBanner.className = 'bg-gradient-to-r from-blue-500 to-indigo-400 text-white rounded-3xl p-6 shadow-lg relative overflow-hidden transition-all duration-300';
                bannerBgIcon.className = 'fa-solid fa-dog';

                speciesBadge.className = 'bg-blue-100 text-pawtion-dogBlue font-bold text-xs px-2.5 py-1 rounded-full';
                speciesBadge.innerHTML = '🐶 สุนัข';

                document.getElementById('petName').value = 'น้องโกลเด้น';
            }

            renderAvatars();
            renderLifeStages();
            calculatePawtion();
        }

        // Render Avatar Options
        function renderAvatars() {
            const container = document.getElementById('avatarContainer');
            container.innerHTML = '';
            const avatars = currentSpecies === 'cat' ? catAvatars : dogAvatars;
            selectedAvatar = avatars[0];

            avatars.forEach((emoji, index) => {
                const div = document.createElement('div');
                div.className = `avatar-option cursor-pointer w-11 h-11 rounded-2xl border-2 border-transparent flex items-center justify-center text-2xl transition bg-purple-50/50 ${index === 0 ? 'selected' : ''}`;
                div.textContent = emoji;
                div.onclick = function() {
                    document.querySelectorAll('.avatar-option').forEach(el => el.classList.remove('selected'));
                    div.classList.add('selected');
                    selectedAvatar = emoji;
                    document.getElementById('resAvatar').textContent = selectedAvatar;
                };
                container.appendChild(div);
            });
            document.getElementById('resAvatar').textContent = selectedAvatar;
        }

        // Render Life Stage Options
        function renderLifeStages() {
            const select = document.getElementById('lifeStage');
            select.innerHTML = '';
            const options = lifeStagesData[currentSpecies];

            options.forEach(opt => {
                const optionEl = document.createElement('option');
                optionEl.value = opt.factor;
                optionEl.textContent = `${opt.text} (x${opt.factor})`;
                if (opt.default) optionEl.selected = true;
                select.appendChild(optionEl);
            });
        }

        // Update Slider Ratio Display
        function updateRatioDisplay() {
            const val = document.getElementById('dryRatio').value;
            document.getElementById('mainRatioDisplay').textContent = `อาหารแห้ง ${val}% : อาหารเปียก ${100 - val}%`;
        }

        // Reset Default Calorie Densities
        function resetCalorieDefaults() {
            if (currentSpecies === 'cat') {
                document.getElementById('dryCalPer100g').value = 380;
                document.getElementById('wetCalPer100g').value = 90;
            } else {
                document.getElementById('dryCalPer100g').value = 360;
                document.getElementById('wetCalPer100g').value = 110;
            }
            calculatePawtion();
        }

        // Core Pawtion Calculation Logic
        function calculatePawtion() {
            if (!document.getElementById('healthConfirm').checked) return;

            // Inputs
            const name = document.getElementById('petName').value.trim() || 'สัตว์เลี้ยง';
            const weight = parseFloat(document.getElementById('petWeight').value) || 0;
            const years = parseInt(document.getElementById('petAgeYears').value) || 0;
            const months = parseInt(document.getElementById('petAgeMonths').value) || 0;
            const factor = parseFloat(document.getElementById('lifeStage').value) || 1.2;
            const dryCalPer100g = parseFloat(document.getElementById('dryCalPer100g').value) || 380;
            const wetCalPer100g = parseFloat(document.getElementById('wetCalPer100g').value) || 90;
            const dryRatioVal = parseFloat(document.getElementById('dryRatio').value) / 100;
            const mealsPerDay = parseInt(document.querySelector('input[name="mealsPerDay"]:checked').value) || 2;

            // Update Summary Name & Age
            document.getElementById('resPetName').textContent = name;
            const speciesText = currentSpecies === 'cat' ? 'แมว' : 'สุนัข';
            document.getElementById('resSummarySubtitle').textContent = `${speciesText} • อายุ ${years} ปี ${months} เดือน • ${weight.toFixed(1)} kg`;

            if (weight <= 0) {
                document.getElementById('totalCalories').textContent = '0';
                return;
            }

            // 1. RER Calculation
            // Cat & Dog Standard RER formula: 70 * (Weight ^ 0.75)
            const rer = 70 * Math.pow(weight, 0.75);
            
            // 2. DER Calculation (Total Daily Calories)
            const der = rer * factor;

            document.getElementById('totalCalories').textContent = Math.round(der);
            document.getElementById('rerFormulaDetail').textContent = `(RER: ${Math.round(rer)} kcal × ตัวคูณ ${factor})`;

            // 3. 90/10 Rule Split
            const mainFoodCalTarget = der * 0.90; // 90%
            const treatCalTarget = der * 0.10;    // 10% max

            document.getElementById('mainCalTarget').textContent = `${Math.round(mainFoodCalTarget)} kcal`;
            document.getElementById('treatCalTarget').textContent = Math.round(treatCalTarget);

            // 4. Split Main Food into Dry & Wet based on slider
            const dryCalorieQuota = mainFoodCalTarget * dryRatioVal;
            const wetCalorieQuota = mainFoodCalTarget * (1 - dryRatioVal);

            // Convert to Grams
            const dryGramsDay = (dryCalorieQuota / dryCalPer100g) * 100;
            const wetGramsDay = (wetCalorieQuota / wetCalPer100g) * 100;

            document.getElementById('dryGramsDay').textContent = Math.round(dryGramsDay);
            document.getElementById('wetGramsDay').textContent = Math.round(wetGramsDay);

            // 5. Water Requirement Target
            // Standard: Cats ~ 50-60ml/kg, Dogs ~ 60-70ml/kg
            const waterMultiplier = currentSpecies === 'cat' ? 55 : 65;
            document.getElementById('waterReq').textContent = Math.round(weight * waterMultiplier);

            // 6. Meal Schedule Plan Breakdown
            document.getElementById('mealCountText').textContent = mealsPerDay;
            const scheduleList = document.getElementById('mealScheduleList');
            scheduleList.innerHTML = '';

            const dryPerMeal = Math.round(dryGramsDay / mealsPerDay);
            const wetPerMeal = Math.round(wetGramsDay / mealsPerDay);

            const mealNames = mealsPerDay === 2 ? ['มื้อเช้า', 'มื้อเย็น'] :
                              mealsPerDay === 3 ? ['มื้อเช้า', 'มื้อกลางวัน', 'มื้อเย็น'] :
                              ['มื้อเช้า', 'มื้อกลางวัน', 'มื้อเย็น', 'มื้อก่อนนอน'];

            for (let i = 0; i < mealsPerDay; i++) {
                let parts = [];
                if (dryPerMeal > 0) parts.push(`อาหารแห้ง <span class="font-bold text-amber-900">${dryPerMeal}g</span>`);
                if (wetPerMeal > 0) parts.push(`อาหารเปียก <span class="font-bold text-pawtion-purpleDark">${wetPerMeal}g</span>`);

                const item = document.createElement('div');
                item.className = 'flex justify-between items-center border-b border-purple-100/60 pb-1 last:border-0';
                item.innerHTML = `
                    <span class="font-medium text-gray-700">${mealNames[i] || `มื้อที่ ${i+1}`}</span>
                    <span>${parts.join(' + ') || '0g'}</span>
                `;
                scheduleList.appendChild(item);
            }
        }

        // Initialize App
        window.onload = function() {
            renderAvatars();
            renderLifeStages();
            updateRatioDisplay();
        };
    </script>
</body>
</html>
